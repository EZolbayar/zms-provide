<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} %highlight{%-5level} [%thread] %logger{36} - %msg%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <Logger name="com.example.zms_upload" level="INFO" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>
        <!-- Logs the full Sain request/response bodies (Feign Logger.Level.FULL only emits at DEBUG). -->
        <Logger name="com.example.terguun.client.SainServiceClient" level="DEBUG" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>
        <Root level="INFO">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
